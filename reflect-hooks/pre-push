#!/bin/sh
# pre-push：机器块必须新鲜、闸门必须全绿 —— Einfacht 平台（重构版）+ 本仓专属闸门合流。
#
# 为什么 pre-commit 已经查了 pre-push 还要查：pre-commit 会自动重算，但**产物可能在
# 上次提交之后又变了** —— 那种情况下推出去的文档就已经是旧的了。pre-push **不自动改
# 文件、不动历史**：不新鲜就直接拒推，强制先提交再推。
set -e
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# 可拔插件（Einfacht issue #8）：repo-local REFLECT_* 载体 = Einfacht.env。
[ -f "$HERE/einfacht-env.sh" ] && . "$HERE/einfacht-env.sh"
REPO=$(CDPATH= cd -- "$HERE/.." && pwd)
cd "$REPO"
GH="$REPO/.githooks"

# ── ① 机器块新鲜（平台块 + 本仓两个 AUTO 块）──────────────────────────────────
DOC=${REFLECT_DOC:-STATE.md}
if [ -f "$DOC" ]; then
  python3 zreflect/facts.py --check "$DOC"
fi
python3 "$GH/update-state.py" --check
python3 "$GH/update-readme.py" --check

# ── ② 平台闸门：执行面唯一产地（上游 C1；与 pre-commit 同源，别再 glob）───────
REFLECT_LOCKS=build/upstream-lock.json REFLECT_PINS=build/pins.json python3 zreflect/registry.py --run commit || exit 1

# ── ③ 本仓专属闸门（平台无对应件）─────────────────────────────────────────────
python3 "$GH/check-state.py"
python3 "$GH/check-consistency.py"

# ── ④ 三语 README：**每次推送必须三份同批更新**（缺一份 ⇒ 拒推）───────────────
#    判据住在 check_readme_sync.py 的 --changed 模式；这里只做 git 的簿记。
#    ⚠️ **诚实边界（2026-10-15 更正一处假声明）**：此前这里写"CI（.github/workflows/
#       readme-sync.yml）跑同一条判据" —— **该文件从未存在，且 `.github/` 整体未被 git
#       跟踪**（`.gitignore` 的 `*` 默认拒绝、无放行规则）⇒ 那句是**空头**，已删。
#       ⇒ 现实：本判据**只有本地 pre-push 一道**（`--no-verify` 可跳过，那是 git 原生出口）；
#       要有 CI 正面兜底，得先给 `.github/` 加白名单并把 workflow 入库（今日未做，见待办）。
#    ⚠️ **判据的适用面（2026-10-15 澄清，回应内容仓 mail/014）**：它按"改动集"判，
#       **不区分内容** —— 只要这批推送没同时改三份 README 就拒。实测：只新增**一个**跟踪
#       文件（`docs/newthing.md` 或 `mail/014.md`，判据一模一样）⇒ 必红。这不是 mail 特殊，
#       而是"新增文件只改得了英文 README 的 AUTO:FILES 块（zh/de 无该块）"。
#       **正确用法**：这类推送应与其 README 更新**同批**（本仓批次收尾本就改三语 README）。
ZERO=0000000000000000000000000000000000000000
CHANGED=$(mktemp)
trap 'rm -f "$CHANGED"' EXIT
refs_checked=0
while read -r lref lsha rref rsha; do
  [ -n "${lref:-}" ] || continue
  case "$lref" in refs/tags/*) continue ;; esac        # tag 推送不携带新内容
  [ "$lsha" = "$ZERO" ] && continue                    # 删分支：没有新东西可要求
  if [ "$rsha" = "$ZERO" ]; then
    # 新分支：只要求「尚未发布到任何远端」的提交；全仓第一推没有 remote-tracking ⇒
    # rev-list 自然返回全部历史（非空），落进下面的正常判定。
    revs=$(git rev-list "$lsha" --not --remotes 2>/dev/null || true)
  else
    revs="$rsha..$lsha"
    git rev-list $revs >/dev/null 2>&1 || revs="$lsha" # 非祖先（强推）⇒ 保守按整条历史
  fi
  if [ -z "$revs" ]; then
    echo "pre-push：$lref 没有要发布的新内容（提交已在远端）⇒ 三语判据对此 ref 无事可查（明说，不假装查过）" >&2
    refs_checked=$((refs_checked + 1))
    continue
  fi
  git log --name-only --pretty=format: $revs 2>/dev/null | sed '/^[[:space:]]*$/d' > "$CHANGED" || true
  if ! python3 zreflect/check_readme_sync.py --changed "$CHANGED"; then
    echo "pre-push 拒绝：$lref 这批推送没把三语 README **同批**更新（CI 跑同一条判据，" >&2
    echo "           --no-verify 只能躲过本地这一道）。名单可配：REFLECT_READMES。" >&2
    exit 1
  fi
  refs_checked=$((refs_checked + 1))
done
if [ "$refs_checked" -eq 0 ]; then
  echo "pre-push：没有携带内容的分支推送（tag/删除）⇒ 三语判据无事可查（明说，不假装查过）" >&2
fi
