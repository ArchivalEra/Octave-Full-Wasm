# Einfacht.env —— Octave-Full-Wasm 事实系统配置（本仓口径）。
# 由 reflect-hooks/einfacht-env.sh 加载；钩子语境里这是旋钮的唯一可复现来源。
export REFLECT_FACTS="build/FACTS.json"
export REFLECT_DOC="STATE.md"
export REFLECT_DOCS="STATE.md,AGENTS.md,README.md,README.zh.md,README.de.md,CONTEXT.md"
export REFLECT_READMES="README.md,README.zh.md,README.de.md"
export REFLECT_HISTORY_SECS="5,9,10"
export REFLECT_RETRACTIONS="build/lib/retractions.json"
export REFLECT_QUESTIONS=".scratch/open-questions/issues"
# ★ 采集模块（上游 #15 C3，2026-10-18 整层升级）：本仓数据层在 zreflect/measure_octave.py。
#   上游 facts.py 的 _measure() 读这个旋钮分派（夹具场景自动回落占位 + 响亮警告）
#   —— 取代本仓原来自制的硬编码分派（已随整层升级退役）。
export REFLECT_MEASURE_MODULE="measure_octave"
# ⚠️ 行尾**不能写 `#` 注释**（2026-10-10 实测踩到）：`export X="v"  # 注释` 里的文字会被
#    **并进值里**（sh 只在**单词开头**才把 `#` 当注释）⇒ 闸门拿着
#    `build/upstream-lock.json"   # 本仓…` 去找文件 ⇒ 报"不存在"。注释只能单独成行。
# ⚠️ `REFLECT_LOCKS` 也**故意不在这里全局配**（2026-10-10 实测踩到，与 DOCTOR 同族）：
#   它的值是「配了就必须存在」的路径，而 gates-selftest 的**跨仓库夹具**是临时目录、
#   当然没有 build/upstream-lock.json ⇒ 全局配 ⇒ 夹具里 FATAL（可配置性自证红）。
#   ⇒ 内联传给需要它的那次调用（见 reflect-hooks/pre-commit）。

# ⚠️ `REFLECT_PINS` **故意不配**（2026-10-10 实测裁决）：
#   上游的 `zreflect/check_pins.py` 是**通用**闸门（schema = `worktree` 指向宿主 git 工作树，
#   靠 `git -C <wt> rev-parse HEAD` 对读）；而本仓的 `build/upstream-pins.json` 是给
#   **本仓专属**的 `.githooks/witness-upstream-pin.py` 用的（schema = `submodule_path` +
#   `container_path`，靠**容器树里的 `.upstream-pin` stamp** 对读）—— 两份 schema 不同源。
#   指错了 ⇒ 通用闸门报 `KeyError: 'worktree'`（实测）。
#   ⇒ 本仓的 pin 见证由 `.githooks/witness-upstream-pin.py` 承担（pre-commit 里跑），
#      通用闸门**明说 OFF**（配了就等于互相打架）。要让通用闸门也真跑 ⇒ 得另写一份
#      worktree-schema 的规格文件，本批不做（记在 NOTES-emsdk-upgrade 的待办里）。

# ⚠️ 三类旋钮**故意不在这里全局配**（都是「配置了就必须存在」族）——
#    全局配 ⇒ gates-selftest.sh 的**跨仓库夹具**里 GATE_REPO 是临时目录、那些文件
#    当然不在 ⇒ 误报「名字写死在代码里」（2026-10-09 实测：`REFLECT_INSTRUMENTS`）。
#    ⇒ 一律**内联**传给需要它的那次调用（见 reflect-hooks/pre-commit）：
#      · REFLECT_INSTRUMENTS / REFLECT_INSTRUMENT_DAYS —— 给 check_instruments
#      · REFLECT_DOCTOR —— 给 doctor（2026-10-10 上游 C1–C5 采纳后实测：它 runs_at=
#        「start-of-work」不进 pre-commit，但**会被夹具的 --all-runnable 扫到**，
#        而夹具里没有 doctor.json ⇒ 红。这正是上游 C3「名册自洽性脱离载体开关」抓的。）
