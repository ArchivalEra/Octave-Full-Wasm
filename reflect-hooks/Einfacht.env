# Einfacht.env —— Octave-Full-Wasm 事实系统配置（本仓口径）。
# 由 reflect-hooks/einfacht-env.sh 加载；钩子语境里这是旋钮的唯一可复现来源。
export REFLECT_FACTS="build/FACTS.json"
export REFLECT_DOC="STATE.md"
export REFLECT_DOCS="STATE.md,AGENTS.md,README.md,README.zh.md,README.de.md,CONTEXT.md"
export REFLECT_READMES="README.md,README.zh.md,README.de.md"
export REFLECT_HISTORY_SECS="5,9,10"
export REFLECT_RETRACTIONS="build/lib/retractions.json"
export REFLECT_QUESTIONS=".scratch/open-questions/issues"
export REFLECT_DOCTOR="doctor.json"

# ⚠️ REFLECT_INSTRUMENTS / REFLECT_INSTRUMENT_DAYS **故意不在这里全局配**：
#   它们是「配置了就必须存在」的旋钮（指向缺失 = FATAL），而 gates-selftest.sh 的
#   跨仓库夹具只覆盖 REFLECT_FACTS/DOC/DOCS/… 六个名字、**不覆盖**这两个 ——
#   全局配 ⇒ 夹具里 GATE_REPO 是临时目录、路径解析失败 ⇒ 误报「名字写死在代码里」。
#   所以本仓照旧把它们**内联**传给 check_instruments 那一次调用（见 reflect-hooks/pre-commit）。
