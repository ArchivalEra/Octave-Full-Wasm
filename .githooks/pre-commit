#!/bin/sh
# Octave-Full-Wasm — pre-commit：重算 README/HANDOFF 的 AUTO 区块并校验白名单
# Copyright (C) 2026 ArchivalEra
# SPDX-License-Identifier: AGPL-3.0-or-later

# 三个 AUTO 区块都是**机器维护**的（README 的文件清单 / HANDOFF 的部署状态 / HANDOFF 的
# 实测事实台账），提交前重算并暂存；再把"活状态断言不得与产物矛盾"与"白名单"两道闸门跑一遍。
set -e
HOOK_DIR="$(dirname "$0")"
# ★ 顺序（2026-10-04 实测踩到）：**HANDOFF 在前、README 在后** —— README 的 AUTO:FILES
#   记的是各文件**字节数**，其中就有 HANDOFF.md；旧顺序先算 README 再重算 HANDOFF 机器块
#   ⇒ HANDOFF 大小一变，README 记的数当提交落地时就过期 ⇒ pre-push 必红、每批补一刀。
python3 "$HOOK_DIR/update-handoff.py"
git add HANDOFF.md
python3 build/facts.py --render-doc HANDOFF.md
git add HANDOFF.md
python3 "$HOOK_DIR/update-readme.py"
git add README.md
python3 "$HOOK_DIR/check-handoff.py"
python3 "$HOOK_DIR/check-consistency.py"
python3 "$HOOK_DIR/check-wants.py"
python3 "$HOOK_DIR/check-whitelist.py"
python3 "$HOOK_DIR/check-retractions.py"
python3 "$HOOK_DIR/check-facts.py"
# ★ 仪器生命周期闸门（Einfacht #6 ① 移植，2026-10-03）：可插拔；这里显式启用两旋钮 ——
#   恒常检测（first_seen 超 30 天 ⇒ 人工确认该 cmd 是在量还是恒返回同一个数）
#   + 量法登记（build/instruments.json：被证伪的量法不许留在台账 cmd 里）。
FACTS_INSTRUMENT_DAYS=30 FACTS_INSTRUMENTS=build/instruments.json python3 "$HOOK_DIR/check-instruments.py"
# ★ F1（2026-09-26）：**闸门自证** —— 闸门不能证明自己会红，就不许提交。
#   放在最后是有意的：前六道是"查仓库"，这一道是"查检查器本身"。
sh "$HOOK_DIR/../build/gates-selftest.sh"
