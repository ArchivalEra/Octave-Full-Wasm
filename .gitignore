!.githooks/update-readme.py
!.githooks/update-handoff.py
!.githooks/check-handoff.py
!.githooks/check-consistency.py
!.githooks/handoff_facts.py
!.githooks/handoff-context.py
!.zcode/config.json
!.githooks/check-whitelist.py
!.githooks/check-wants.py
!build/webgraphics/*
!build/webdoc/*
!build/assets-meta.json
!test/browser/fixtures/*

# ── 可部署站点（8761 的逐字节镜像；DEPLOY.md 有部署说明）────────────────────
!site/
!site/**

# ── CI：把 site/ 部署到 isui.ren/Octave（heart@deploy）─────────────────────
# 逐文件点名。`.github/` 此前从未入库：pages-deploy.yml 被开头的 `*` ignore 掉
# 且从未 git add，而 check-whitelist.py 只看 git ls-files，所以从没报出来过。
!.github/workflows/deploy-heart.yml
