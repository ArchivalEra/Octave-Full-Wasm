# 白名单 .gitignore：默认拒绝一切，逐项放行。
# 目录先放行（只为能走进去），文件逐个点名。新增文件必须同步加白名单，
# 否则 check-whitelist.py 在 pre-commit 直接拦下。
*
!*/
!.gitignore
!README.md
!LICENSE
!THIRD-PARTY-NOTICES.md
!HANDOFF.md
!HISTORY.md
!AGENTS.md
!build/Makefile
!build/main.cc
!build/NOTES.md
!build/reconf.sh
!build/reconf-batch1b.sh
!build/reconf-batch1.sh
!build/CLIBS.md
!build/GAPS.md
!build/GAPS-2.md
!build/GPT-REVIEW-2.md
!build/BASELINE-10.3.md
!build/BASELINE-11.3.md
!build/113/*
!build/BENCH.md
!build/reconf-bench.sh
!build/plotbridge/*
!build/webaudio/*
!build/webaudiorec/*
!build/webnet/*
!build/webnet.cc
!build/fftw_threads_stub.c
!build/second_stub.f
!build/normalize_arpack.py
!build/build_dldfcn.sh
!build/reconf-pic.sh
!build/rebuild-pic-libs.sh
!build/build_oct.sh
!build/make-dist.sh
!dist/DEPLOY.md
!dist/serve.py
!bridge/assets-loader.js
!bridge/queue.js
!bridge/index.html
!build/assets.py
!build/render-docstrings.py
!build/render_docstring_batch.m
!build/prerender-m-docstrings.py
!build/check_m.py
!build/glue-selftest.m
!build/glue-selftest.sh
!build/promote-webgl.sh
!build/recover-113.sh
!build/post.js
!build/webjslib.js
!build/webshell/*
!build/webshims/*
!build/embed/*
!build/113/probe-jspi/*
!build/113/probe-jspi-worker/*
!build/113/probe-threads/*
!build/forge-preload/*
!build/webfile/*
!build/pkgfix/*
!build/pkgrestore/*
!build/recover.sh
!build/check-site-parity.sh
!build/check-deploy-sha.sh
!build/check-boot.sh
!build/webio.cc
!build/webimage.cc
!build/webfilepick.cc
!build/build_pkg_oct.sh
!build/forge-fetch.py
!build/forge-build.sh
!test/browser/*.mjs
!bridge/webaudio.js
!bridge/webaudiorec.js
